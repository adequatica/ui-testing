{
  "name": "ui-testing",
  "version": "1.0.0",
  "description": "UI Testing with TypeScript and Playwright",
  "type": "module",
  "keywords": [
    "testing",
    "playwright"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/adequatica/ui-testing"
  },
  "author": "Andrey Enin",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@playwright/test": "1.65.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "eslint": "10.15.0",
    "eslint-plugin-import-x": "4.18.1",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0"
  },
  "scripts": {
    "format": "npx prettier --write .",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test": "playwright test",
    "test:debug": "PWDEBUG=1 playwright test",
    "test:install-deps": "playwright install chromium && playwright install-deps chromium"
  }
}
